# Configure no Hostless Secrets. Nunca publique chaves reais.
API_KEY=replace-with-a-long-random-secret
PORT=8000

# Opcional: caminho do executável, se não estiver no PATH.
# YTDLP_PATH=/usr/local/bin/yt-dlp

# Opcional: fallback final do YouTube pelo agente Termux/A10s.
# Configure o mesmo segredo em melissa-iptv (REVERSE_AGENT_TOKEN).
# REVERSE_AGENT_URL=https://melissa-iptv.hostless.app/reverse-download
# REVERSE_AGENT_TOKEN=replace-with-the-same-random-secret
# REVERSE_AGENT_TIMEOUT_MS=690000
