# Configure chaves fortes e diferentes no provedor. Nunca publique chaves reais.
OWNER_API_KEY=replace-with-a-long-random-secret
FRIEND_API_KEY=replace-with-a-different-long-random-secret
MAX_QUEUE=30
EXTRACT_TIMEOUT=90
MEDIA_TIMEOUT=120
PORT=10000

# Opcional: defina apenas se a instalação do yt-dlp oferecer suporte.
YTDLP_IMPERSONATE=chrome
