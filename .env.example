# Set strong, different secrets in Render. Never commit real keys.
OWNER_API_KEY=replace-with-a-long-random-secret
FRIEND_API_KEY=replace-with-a-different-long-random-secret
MAX_QUEUE=30
EXTRACT_TIMEOUT=90
PORT=10000

# yt-dlp uses curl_cffi impersonation by default. Override only if supported.
YTDLP_IMPERSONATE=chrome
